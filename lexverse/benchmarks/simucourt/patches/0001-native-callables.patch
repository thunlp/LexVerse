+def format_prediction(case, prediction, stage, call_judge):
+    if not all(label in prediction for label in ("[法官分析]", "[审判依据]", "[最终判决]")):
+        raise ValueError("native decision sections missing")
+    contents = extract_sections(prediction)
+    if any(token in contents["最终判决"] for token in ("<你的判决", "判决结果（根据", "<你的分析>")):
+        raise ValueError("native decision contains unfilled template placeholders")
+    result_all = contents["最终判决"]
+    if case["类别"] == "刑事":
+        if stage == "second":
+            result_all = "原审法院审判结果：" + case["一审法院审判结果"] + "\n 二审法院审判结果：" + result_all
+        template = prompt_crime_result
+        if stage == "first":
+            # 原脚本只处理二审；一审公开字段使用被告人而非上诉人。
+            template = template.replace("上诉人", "被告人")
+    else:
+        template = prompt_other_result
+    # Preserve native judgment-then-laws request order and extraction examples.
+    judgment = parse_literal(call_judge(template.replace("<RAW_RESULTS>", result_all)), dict)
+    laws = parse_literal(call_judge(prompt_laws.replace("<RAW_LAWS>", contents["审判依据"])), list)
+    return {"法院意见": contents["法官分析"], "判决结果": judgment, "审判依据": laws}
