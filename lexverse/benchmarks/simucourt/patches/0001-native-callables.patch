+def parse_literal(text, expected):
+    text = text.strip().removeprefix("输出列表：").removeprefix("输出列表:").strip()
+    if text.startswith("```") and text.endswith("```"):
+        text = text.split("\n", 1)[1].rsplit("```", 1)[0].strip()
+    try:
+        value = json.loads(text)
+    except json.JSONDecodeError:
+        value = ast.literal_eval(text)
+    if not isinstance(value, expected):
+        raise ValueError("native extraction type mismatch")
+    if expected is list and any(not isinstance(x, str) for x in value):
+        raise ValueError("native laws must be strings")
+    if expected is dict and any(not isinstance(k, str) or not isinstance(v, str) for k, v in value.items()):
+        raise ValueError("native judgment must be string fields")
